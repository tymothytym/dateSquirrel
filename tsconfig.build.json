{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // No "node" here: src/ uses no Node builtins, so published .d.ts files must
    // not drag @types/node into consumers' projects.
    "types": ["vite/client"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
