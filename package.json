{
  "name": "date-squirrel",
  "version": "2.0.0",
  "description": "A year/month/day drill-down date picker with a nutty tang. Zero dependencies, framework-agnostic.",
  "type": "module",
  "keywords": [
    "date-picker",
    "datepicker",
    "month-picker",
    "year-picker",
    "web-component",
    "custom-element",
    "vanilla-js",
    "accessibility"
  ],
  "author": "Tim O'Donoghue",
  "license": "MIT",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./styles.css": "./dist/date-squirrel.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "readme.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/screenshots.mjs",
    "gif": "node scripts/demo-gif.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "gifenc": "^1.0.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tymothytym/dateSquirrel.git"
  },
  "bugs": {
    "url": "https://github.com/tymothytym/dateSquirrel/issues"
  },
  "homepage": "https://github.com/tymothytym/dateSquirrel#readme",
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.5"
  ]
}
